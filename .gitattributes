# Auto detect text files and perform LF normalization
* text=auto eol=lf

*.py text diff=python
*.md text
*.yaml text
*.yml text
*.toml text
*.json text
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.ipynb text

# Large Model and Binary assets with Git LFS if tracked
*.gguf filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
